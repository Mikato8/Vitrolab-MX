# Despliegue en Hostinger cuando el documento raíz es public_html y no se
# puede apuntar directamente a public/. Redirige a public/ y bloquea
# directorios sensibles.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^(app|config|database|storage|bin|tests|vendor|docs|tools|ai-service)(/|$) - [F,L]
    RewriteRule ^\.env - [F,L]
    RewriteRule ^(composer\.(json|lock)|README\.md|LICENSE|CONTRIBUTING\.md|SECURITY\.md|\.git)(/|$) - [F,L]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
