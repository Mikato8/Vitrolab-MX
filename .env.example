# ---------------------------------------------------------------------------
# VitroLab MX · configuración
# ---------------------------------------------------------------------------
APP_NAME="VitroLab MX"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tu-dominio.mx
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es_MX
APP_KEY=

# Neon PostgreSQL. En Hostinger, PDO necesita el parámetro options con el
# endpoint para que el libpq encuentre la rama correcta. Usa el host DIRECTO
# (sin -pooler) y el endpoint sin -pooler.
# DATABASE_URL="postgresql://USUARIO:CLAVE@ep-xxxx.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require&options=endpoint%3Dep-xxxx"
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
DB_DRIVER=pdo

SESSION_NAME=vitrolab_session
SESSION_LIFETIME=7200
SESSION_SECURE=true

UPLOAD_MAX_BYTES=8388608
UPLOAD_MAX_FILES=4
UPLOAD_MAX_DOCUMENT_BYTES=12582912

MAIL_ENABLED=false
MAIL_FROM=no-reply@vitrolab.mx
MAIL_FROM_NAME="VitroLab MX"
AUTO_VERIFY_USERS=false
